	<div class="main w-full min-h-screen bg-zinc-900 ">
		<div class="form p-10 text-white">
			<!-- name is used to see the user data in the backend -->
			<!-- /create pe form data sumbit hoga with post method -->
			<form action="/formData" method="POST">
				<input class=" outline-none block px-5 py-2 w-full rounded-lg  bg-zinc-800 h-[50px]" type="text"
					placeholder="Title goes here" name="title">
				<textarea class=" outline-none block px-5 mt-2 py-2 w-full rounded-lg resize-none bg-zinc-800 h-[300px]"
					name="details" id="" placeholder="Write your task details here..."></textarea>
				<input class="mt-2 bg-blue-600 px-5 py-2 rounded-md" type="submit" value="Create Task">
			</form>
		</div>
		<div class="tasks p-10 flex gap-3 flex-wrap">
			<!-- EJS CODE -->
			<!-- ✔ Checks if files exist -->
			<% if (files.length> 0) { %>
				<% files.forEach(function(val){ %>
					<div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
						<!-- ye files ko list karega -->
						<h1 class="text-white text-3xl tracking-tighter">
							<%= val %>
						</h1>
						<div class="flex w-full justify-between items-center mt-3">
							<a class="text-blue-500 inline-block" href="/file/<%= val%>">Read More </a>
							<a class="text-zinc-600" href="/edit/<%= val%>">Edit filename</a>
						</div>
						<!-- <h1 class="text-white text-3xl tracking-tighter">Some task goes Here</h1>
						<a class="text-blue-500 inline-block mt-3" href="/read/<%= val %>">Read More </a> -->
					</div>
					<% }) %>
						<% } else { %>
							<h3 class="text-zinc-600">No tasks yet.</h3>
							<% } %>
								<!-- EJS CODE -->
		</div>
	</div>
</body>

